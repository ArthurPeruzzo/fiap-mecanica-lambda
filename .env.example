# Base URL da aplicacao fiap-mecanica (sem barra no final).
# Ex.: http://internal-alb-xxxx.us-east-1.elb.amazonaws.com
APP_BASE_URL=http://localhost:8080

# Mesmo segredo usado pela aplicacao (JWT_SECRET). String Base64URL com
# no minimo 32 bytes apos decodificar. O token so e aceito pelo filtro da
# aplicacao se este valor for identico ao dela.
JWT_SECRET=troque-por-um-segredo-base64url-com-no-minimo-32-bytes-decodificados

# Emissor do token. Precisa bater com jwt.issuer da aplicacao.
JWT_ISSUER=mecanica-fiap

# Validade do token em horas (default 4, igual a aplicacao).
TOKEN_TTL_HOURS=4

# Timeout (ms) da chamada HTTP a aplicacao.
HTTP_TIMEOUT_MS=3000
