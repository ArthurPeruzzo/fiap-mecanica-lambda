{
  "name": "fiap-mecanica-lambda",
  "version": "0.1.0",
  "private": true,
  "description": "Function Lambda de autenticacao de cliente por CPF - Fase 3 (Mecanica FIAP)",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/handler.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "invoke:local": "npm run build && node --env-file=.env scripts/invoke-local.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=cjs --minify --outfile=build/handler.js",
    "package": "rm -rf build && npm run bundle && cd build && zip -q -X function.zip handler.js"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
